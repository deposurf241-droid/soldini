rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(spaceId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/spaces/$(spaceId)).data.memberIds;
    }
    match /users/{userId}/transactions/{txId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }
    match /spaces/{spaceId} {
      allow get, list: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name','ownerUid','memberIds','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;
      allow update: if signedIn() && request.auth.uid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds','name'])
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() <= 10
        && resource.data.ownerUid in request.resource.data.memberIds
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40;
      allow delete: if false;
      match /transactions/{txId} {
        allow read, create, update, delete: if isMember(spaceId);
      }
    }
  }
}
